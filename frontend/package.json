  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@vitejs/plugin-vue": "5.2.1",
    "openapi-typescript": "7.6.1",
    "sass": "1.83.4",
    "typescript": "5.6.3",
    "vite": "6.0.11",
    "vue-tsc": "2.2.0"
